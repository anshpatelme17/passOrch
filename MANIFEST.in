# Source-only files that should also land in the sdist. The wheel carries the
# SPA via ``[tool.setuptools.package-data]`` in pyproject.toml; MANIFEST.in
# exists so ``python -m build --sdist`` stays complete too.
graft app/frontend
prune app/frontend/__pycache__
global-exclude *.py[cod] .DS_Store Thumbs.db
